{
  "name": "@bytesbybrandon/living-docs",
  "version": "0.2.0",
  "description": "Turn a source document into a designed, self-contained living doc: academic paper, dark reading notes, or telemetry console. Ships an AXI CLI and an MCP server.",
  "type": "module",
  "license": "MIT",
  "author": "Brandon D. Phillips",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytesbybrandon/living-docs.git"
  },
  "homepage": "https://github.com/bytesbybrandon/living-docs#readme",
  "bugs": {
    "url": "https://github.com/bytesbybrandon/living-docs/issues"
  },
  "keywords": [
    "agent",
    "axi",
    "mcp",
    "documentation",
    "html",
    "pdf",
    "living-docs",
    "telemetry",
    "paper"
  ],
  "bin": {
    "living-docs-axi": "bin/living-docs-axi.js",
    "living-docs-mcp": "bin/living-docs-mcp.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./render": "./src/render/index.js",
    "./ingest": "./src/ingest/index.js"
  },
  "files": [
    "bin",
    "src",
    "samples",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/cli.test.js tests/ingest.test.js tests/mcp.test.js tests/motion.test.js tests/render.test.js tests/style.test.js tests/validate.test.js",
    "samples": "node scripts/build-samples.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "unpdf": "^2.1.0"
  }
}
